{
  "name": "querymongo",
  "type": "module",
  "version": "1.5.0",
  "description": "SQL to MongoDB Query Converter CLI",
  "main": "dist/index.js",
  "bin": "dist/cli/main.js",
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli/main.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts",
    "test": "node --experimental-strip-types --experimental-test-coverage --test \"**/*.{spec,integration}.ts\"",
    "format": "npx prettier --write ."
  },
  "keywords": [
    "sql",
    "mongodb",
    "converter",
    "query"
  ],
  "repository": {
    "url": "https://github.com/rubsuadav/querymongo",
    "type": "git"
  },
  "homepage": "https://github.com/rubsuadav/querymongo",
  "author": "rubsuadav",
  "license": "ISC",
  "engines": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "lodash": "^4.18.1",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
